# Vercel OIDC token for authentication
# This is auto-populated by the Vercel CLI via `vercel env pull`
# Local developers should not manually set this value
VERCEL_OIDC_TOKEN=

# Google Analytics 4 measurement ID (starts with "G-").
# Analytics is disabled (no script loads) when this is unset, so it's safe
# to leave blank in local/preview environments.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Secret used to sign/verify the donor portal magic-link token
# (src/lib/portal-token.ts). Generate with `openssl rand -hex 32`. Rotating
# it invalidates every link currently in someone's inbox.
PORTAL_TOKEN_SECRET=

# Resend API key, used to send the donor portal magic-link email.
RESEND_API_KEY=

# "Display Name <verified@yourdomain>" to send the magic-link email from.
# Falls back to Resend's shared onboarding@resend.dev sender (test-only,
# low deliverability) when unset — set this once a sending domain is
# verified in the Resend dashboard.
RESEND_FROM_EMAIL=

# Stripe API key, used for server-side payment processing (gated behind CAN_ACCEPT_ONLINE_DONATIONS)
STRIPE_SECRET_KEY=

# Stripe webhook signing secret, used to verify webhooks from Stripe
STRIPE_WEBHOOK_SECRET=

# Base URL for the site, used in metadata and payment emails
# Falls back to "http://localhost:3000" in development when unset
NEXT_PUBLIC_SITE_URL=

# Feature flag to enable online donations via Stripe (preview/staging only)
# Set to "true" to enable donations in preview deployments
NEXT_PUBLIC_STAGING=
