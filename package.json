{
  "name": "kothom",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "concurrently -k -n content,next -c magenta,cyan 'velite --watch --strict' 'next dev'",
    "build": "velite --clean --strict && next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "velite --clean --strict && tsc --noEmit",
    "test": "velite --clean --strict && vitest run",
    "test:watch": "velite --strict && vitest",
    "test:e2e": "playwright test",
    "prepare": "husky",
    "content": "velite --clean --strict"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md}": "biome check --write --no-errors-on-unmatched"
  },
  "dependencies": {
    "@next/third-parties": "^16.2.11",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.18.0",
    "stripe": "^22.3.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vercel/config": "^0.7.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^10.0.5",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.5.0",
    "opentype.js": "^2.0.0",
    "picomatch": "^4.0.7",
    "rehype-slug": "^6.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "velite": "^0.4.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  },
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
